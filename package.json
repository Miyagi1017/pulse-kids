{
  "name": "pulse-kids",
  "private": true,
  "version": "2.0.0",
  "description": "Le journal animé des p'tits curieux : une actualité positive par jour en dessin animé interactif pour les enfants de 5 ans.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"shared/**/*.test.ts\" \"server/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "illustrations": "tsx scripts/generate-illustrations.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
