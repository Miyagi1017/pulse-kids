# Copier en .env.local pour le développement (ou : npx vercel env pull .env.local)
# Aucune de ces variables n'est obligatoire : sans elles, l'app tourne en mode local/invité.

# Postgres (Neon) — cache de l'édition du jour et limitation de débit.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Google Gemini — génère l'édition du jour (1 appel max par jour, mis en cache).
GEMINI_API_KEY=""
# Optionnel : modèle Gemini à utiliser
GEMINI_MODEL="gemini-2.5-flash"
