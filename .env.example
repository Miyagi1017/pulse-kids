# Copier en .env.local pour le développement (ou : neon env pull / npx vercel env pull .env.local)
# Aucune de ces variables n'est obligatoire : sans elles, l'app tourne avec ses histoires embarquées.

# ---- Base de données : Neon Postgres (cache du jour + limitation de débit) ----
DATABASE_URL="postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Connexion directe, utilisée seulement pour les migrations (npm run db:migrate)
DATABASE_URL_UNPOOLED="postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- IA : génère l'édition du jour (1 appel max par jour). Essayés dans cet ordre. ----
# 1) Google Gemini — clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 2) N'importe quelle API compatible OpenAI. Exemples :
#    Groq       AI_BASE_URL="https://api.groq.com/openai/v1"   AI_MODEL="llama-3.3-70b-versatile"
#    OpenRouter AI_BASE_URL="https://openrouter.ai/api/v1"     AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"
#    Mistral    AI_BASE_URL="https://api.mistral.ai/v1"        AI_MODEL="mistral-small-latest"
#    Ollama     AI_BASE_URL="http://localhost:11434/v1"        AI_MODEL="qwen2.5:7b"   (local, sans clé)
AI_BASE_URL=""
AI_MODEL=""
AI_API_KEY=""

# ---- Photo de l'espace du jour (NASA, domaine public) ----
# Optionnel : clé perso gratuite (https://api.nasa.gov) ; sinon DEMO_KEY puis la NASA Image Library (sans clé).
NASA_API_KEY=""

# ---- Tâche planifiée (préparation du contenu chaque matin) ----
# Optionnel : si défini, /api/cron/daily exige ce secret (Vercel l'envoie automatiquement).
CRON_SECRET=""
